# ==========================================
# NovaChat Production & Local Environment Variables
# Copy this file to .env for local development
# Configure these variables in Railway Cloud Dashboard
# ==========================================

# Core Django Settings
SECRET_KEY=django-insecure-change-this-to-a-super-secret-key-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,.railway.app
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,https://*.railway.app

# Database Configuration
# LOCAL DEV: Leave empty to use SQLite, or set a local PostgreSQL connection
# RAILWAY: Automatically set by Railway when PostgreSQL plugin is added - DO NOT SET MANUALLY
DATABASE_URL=

# Google OAuth 2.0 Credentials (From Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# REDIS_URL - LOCAL: Set to local Redis or leave empty for InMemory, RAILWAY: Auto-set by Railway
REDIS_URL=

# Production Security & SSL (Automated on Railway Cloud)
SECURE_SSL_REDIRECT=False

# Media & Storage Configuration (Optional Cloudinary setup)
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
