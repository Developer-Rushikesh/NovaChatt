# ==========================================
# NovaChat Production & Local Environment Variables
# Copy this file to .env for local development
# Configure these variables in Railway Cloud Dashboard
# ==========================================

# Core Django Settings
SECRET_KEY=django-insecure-change-this-to-a-super-secret-key-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,.railway.app
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,https://*.railway.app

# Database Configuration
# DO NOT hardcode localhost:5432 in Railway environment variables!
# For local dev: Leave empty to automatically use SQLite fallback.
# For Railway production: Railway automatically provisions and injects DATABASE_URL when PostgreSQL service is added.
# DATABASE_URL=postgres://user:password@host:port/dbname

# Google OAuth 2.0 Credentials (From Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# Django Channels & Redis Cache (Railway automatically sets REDIS_URL when Redis plugin is added)
# Leave empty for local InMemoryChannelLayer fallback
# REDIS_URL=redis://default:password@host:port

# Production Security & SSL (Automated on Railway Cloud)
SECURE_SSL_REDIRECT=False

# Media & Storage Configuration (Optional Cloudinary setup)
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
